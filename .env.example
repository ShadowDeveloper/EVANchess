# EVAN: Evidence-Verified Analysis & Narration Configuration

# Path to UCI Stockfish executable (defaults to D:\Chess\Engines\Stockfish\stockfish-windows-x86-64-universal.exe if present)
STOCKFISH_PATH=D:\Chess\Engines\Stockfish\stockfish-windows-x86-64-universal.exe

# Optional secondary UCI engine path (e.g., Lc0 or Berserk)
SECONDARY_ENGINE_PATH=D:\Chess\Engines\Lc0\lc0.exe

# SQLite database path
EVAN_DB_PATH=evan.db

# LLM Provider: openrouter | openai | anthropic | local
EVAN_LLM_PROVIDER=openrouter
EVAN_LLM_MODEL=openai/gpt-4o-mini
# Optional custom base URL for OpenAI-compatible local or proxy endpoints
EVAN_LLM_BASE_URL=

# API Keys (Required for live LLM realization per provider)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Engine Budgets (Nodes)
EVAN_ENGINE_THREADS=1
EVAN_ENGINE_HASH_MB=64
EVAN_COARSE_NODES=25000
EVAN_DEEP_NODES_TIER1=75000
EVAN_DEEP_NODES_PRIMARY=150000
EVAN_CHALLENGE_NODES=60000
EVAN_CRITICAL_MOMENTS_COUNT=5
